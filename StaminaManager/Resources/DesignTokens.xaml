<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SafeBrush" Color="#FF107C10" />
            <SolidColorBrush x:Key="AttentionBrush" Color="#FFCA5010" />
            <SolidColorBrush x:Key="UrgentBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5D5D5D" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="NeutralTrackBrush" Color="#1F000000" />
            <StaticResource x:Key="NavigationItemInteractionSurfaceBrush" ResourceKey="CardSurfaceBrush" />
            <StaticResource x:Key="NavigationItemPressedSurfaceBrush" ResourceKey="AppSurfaceBrush" />
            <StaticResource x:Key="NavigationItemInteractionTextBrush" ResourceKey="PrimaryTextBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="SafeBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="AttentionBrush" Color="#FFFFB900" />
            <SolidColorBrush x:Key="UrgentBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FF2C2C2C" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFCFCFCF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#2FFFFFFF" />
            <SolidColorBrush x:Key="NeutralTrackBrush" Color="#2FFFFFFF" />
            <StaticResource x:Key="NavigationItemInteractionSurfaceBrush" ResourceKey="CardSurfaceBrush" />
            <StaticResource x:Key="NavigationItemPressedSurfaceBrush" ResourceKey="AppSurfaceBrush" />
            <StaticResource x:Key="NavigationItemInteractionTextBrush" ResourceKey="PrimaryTextBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SafeBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AttentionBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="UrgentBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AppSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="CardSurfaceBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PrimaryTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SecondaryTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="CardStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="NeutralTrackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="NavigationItemInteractionSurfaceBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="NavigationItemPressedSurfaceBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="NavigationItemInteractionTextBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Yu Gothic UI</FontFamily>

    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing20">20</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>
    <Thickness x:Key="PagePadding">20</Thickness>
    <Thickness x:Key="SurfacePadding">24</Thickness>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <x:Double x:Key="PageTitleFontSize">28</x:Double>
    <x:Double x:Key="CardTitleFontSize">16</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="MetadataFontSize">12</x:Double>
</ResourceDictionary>
