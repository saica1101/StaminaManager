<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StaminaManager.Controls.StaminaRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="120"
    IsTabStop="False"
    mc:Ignorable="d"
    SizeChanged="StaminaRing_SizeChanged">

    <Grid
        x:Name="RingRoot"
        AutomationProperties.AccessibilityView="Content">
        <Ellipse
            Margin="4"
            IsHitTestVisible="False"
            Stroke="{ThemeResource NeutralTrackBrush}"
            StrokeThickness="8" />

        <Path
            x:Name="ProgressPath"
            IsHitTestVisible="False"
            Stroke="{x:Bind StatusBrush, Mode=OneWay}"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="8" />

        <Viewbox
            MaxWidth="96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    FontFamily="{StaticResource AppFontFamily}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    Text="{x:Bind Current, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="/" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="{x:Bind Maximum, Mode=OneWay}" />
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
