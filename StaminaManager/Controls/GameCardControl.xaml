<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StaminaManager.Controls.GameCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StaminaManager.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="292"
    d:DesignWidth="272"
    IsTabStop="False"
    mc:Ignorable="d">

    <Button
        x:Name="CardButton"
        AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind CardAutomationName, Mode=OneWay}"
        Command="{x:Bind ViewModel.EditCommand, Mode=OneWay}"
        Style="{StaticResource AppGameCardButtonStyle}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="44" Height="44">
                    <Border
                        Background="{ThemeResource NeutralTrackBrush}"
                        CornerRadius="8" />
                    <Image
                        x:Name="GameImage"
                        AutomationProperties.AccessibilityView="Raw"
                        ImageFailed="GameImage_ImageFailed"
                        Source="{x:Bind GameImageSource, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind GameImageVisibility, Mode=OneWay}" />
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Glyph="&#xE7FC;"
                        Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource AppCardTitleTextStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <local:StaminaRing
                Grid.Row="1"
                Width="128"
                Height="128"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Current="{x:Bind ViewModel.CurrentStamina, Mode=OneWay}"
                GameName="{x:Bind ViewModel.Name, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.MaxStamina, Mode=OneWay}"
                Ratio="{x:Bind ViewModel.Progress, Mode=OneWay}"
                StatusBrush="{x:Bind StatusBrush, Mode=OneWay}"
                StatusText="{x:Bind StatusText, Mode=OneWay}" />

            <StackPanel Grid.Row="2" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="{StaticResource AppFontFamily}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PrimaryTextBrush}"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource AppSecondaryTextStyle}"
                    Text="{x:Bind RemainingText, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
