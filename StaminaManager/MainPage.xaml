<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StaminaManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="ShellNavigation"
        x:Uid="ShellNavigation"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Auto"
        PaneOpened="ShellNavigation_PaneOpened"
        PaneClosed="ShellNavigation_PaneClosed"
        SelectionChanged="ShellNavigation_SelectionChanged">
        <NavigationView.Resources>
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="NavigationItemInteractionSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="NavigationItemPressedSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundCheckedPointerOver" ResourceKey="NavigationItemInteractionSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundCheckedPressed" ResourceKey="NavigationItemPressedSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="NavigationItemInteractionSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="NavigationItemInteractionSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="NavigationItemPressedSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundChecked" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundCheckedPointerOver" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundCheckedPressed" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="NavigationItemInteractionTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="NavigationItemInteractionTextBrush" />
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="OverviewNavigationItem"
                x:Uid="NavOverview"
                AutomationProperties.AutomationId="NavOverview"
                FontFamily="{StaticResource AppFontFamily}"
                Icon="Home"
                Tag="Overview" />
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                x:Uid="NavSettings"
                AutomationProperties.AutomationId="NavSettings"
                FontFamily="{StaticResource AppFontFamily}"
                Icon="Setting"
                Tag="Settings" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Border
                x:Name="VersionFooterBand"
                AutomationProperties.AutomationId="VersionFooterBand"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="0,1,0,0"
                HorizontalAlignment="Stretch"
                Padding="16,8">
                <StackPanel
                    AutomationProperties.AccessibilityView="Content"
                    Spacing="4">
                    <TextBlock
                        x:Uid="VersionFooterLabel"
                        Style="{StaticResource AppSecondaryTextStyle}" />
                    <TextBlock
                        x:Name="VersionFooterText"
                        AutomationProperties.AutomationId="VersionFooterText"
                        AutomationProperties.Name="{x:Bind VersionFooterAutomationName}"
                        AutomationProperties.HelpText="{x:Bind VersionFooterAutomationName}"
                        Text="{x:Bind VersionText, Mode=OneTime}"
                        Style="{StaticResource AppSecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </NavigationView.PaneFooter>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="AboutNavigationItem"
                x:Uid="NavAbout"
                AutomationProperties.AutomationId="NavAbout"
                FontFamily="{StaticResource AppFontFamily}"
                Icon="Help"
                Tag="About" />
        </NavigationView.FooterMenuItems>

        <ContentControl
            x:Uid="ShellContentHost"
            AutomationProperties.AccessibilityView="Content"
            AutomationProperties.AutomationId="ShellContentFrame"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Frame
                x:Name="ShellContentFrame"
                IsNavigationStackEnabled="False" />
            </ContentControl>
        </NavigationView>

        <ContentControl
            x:Name="CompactContentHost"
            AutomationProperties.AutomationId="CompactContentHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</Page>
