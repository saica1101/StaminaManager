<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StaminaManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{StaticResource Spacing8}">
            <TextBlock
                x:Uid="SettingsPageTitle"
                Style="{StaticResource AppPageTitleTextStyle}" />
            <TextBlock
                x:Uid="SettingsPageDescription"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Style="{StaticResource AppBodyTextStyle}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,24,0,0"
            Padding="{StaticResource SurfacePadding}"
            Background="{ThemeResource CardSurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="{StaticResource Spacing8}">
                <TextBlock
                    x:Uid="SettingsPlaceholderTitle"
                    Style="{StaticResource AppCardTitleTextStyle}" />
                <TextBlock
                    x:Uid="SettingsPlaceholderDescription"
                    MaxWidth="640"
                    Style="{StaticResource AppBodyTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
